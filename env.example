# 通义千问 API Key，申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 邮箱SMTP配置（Hotmail/Outlook）
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
SENDER_EMAIL=your_email@hotmail.com
SENDER_PASSWORD=your_outlook_app_password
RECEIVER_EMAIL=your_receive_email@example.com
